# Frontend runtime keys
VITE_API_URL=https://afro-genie-backend-production.up.railway.app/api
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_USE_FUNCTIONS_EMULATOR=false

# Optional integrations (AI keys are backend-only, not exposed to frontend)
GENIUS_ACCESS_TOKEN=your_genius_access_token
LYRICFIND_API_KEY=your_lyricfind_api_key
LYRICFIND_USERNAME=your_lyricfind_username

# Optional script/admin values
FIREBASE_API_KEY=your_firebase_api_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password
ADMIN_NAME=Admin User

# Feature flags (defaults are conservative; set true/false to override)
# Playback: the YouTube tier is gated by VITE_FLAG_PLAYBACK_YOUTUBE, OFF by
# default. Deprecated alias still honoured: VITE_FLAG_YOUTUBE_PLAYBACK
VITE_FLAG_PLAYBACK_YOUTUBE=false
